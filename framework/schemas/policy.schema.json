{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aef.dev/schemas/policy.schema.json",
  "title": "AEF policy",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "version", "precedence", "riskRules", "escalations", "gates", "approvalRules"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "precedence": {
      "type": "array",
      "items": {
        "enum": [
          "runtime-safety",
          "organization",
          "repository",
          "workflow",
          "agent",
          "task"
        ]
      }
    },
    "appliesTo": {
      "type": "array",
      "items": { "enum": ["low", "medium", "high", "critical"] },
      "minItems": 1
    },
    "riskRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "risk", "paths"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["low", "medium", "high", "critical", "unknown"] },
          "paths": { "type": "array", "items": { "type": "string" } },
          "semantics": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "escalations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "gates": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required", "neverMarkMissingAsPassed"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "neverMarkMissingAsPassed": { "const": true }
      }
    },
    "approvalRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["gate", "minApprovers", "rejectSelfApproval", "invalidateOn"],
        "properties": {
          "gate": { "type": "string" },
          "minApprovers": { "type": "integer", "minimum": 1 },
          "rejectSelfApproval": { "const": true },
          "invalidateOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
