{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ae.sh/schemas/workflow.schema.json",
  "title": "AE workflow definition",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "version", "name", "states", "initial", "terminal", "tasks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string" },
    "deploymentScope": { "enum": ["local", "optional", "required"] },
    "states": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "queued",
          "analyzing",
          "planning",
          "awaiting_approval",
          "implementing",
          "verifying",
          "reviewing",
          "remediating",
          "awaiting_merge",
          "staging",
          "awaiting_release",
          "production_verification",
          "completed",
          "blocked",
          "failed",
          "cancelled"
        ]
      }
    },
    "initial": { "const": "queued" },
    "terminal": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name", "dependsOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["skill", "approval", "gate", "condition"] },
          "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "agent": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "timeout": { "type": "string", "minLength": 2 },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "on": { "type": "object", "additionalProperties": true },
          "condition": { "type": "string" },
          "gate": { "type": "string" },
          "requiredApprovers": { "type": "integer", "minimum": 1 },
          "bindToArtifact": { "type": "string" },
          "onFailure": { "type": "object", "additionalProperties": true },
          "boundedRetries": {
            "type": "object",
            "additionalProperties": true,
            "properties": { "max": { "type": "integer", "minimum": 0, "maximum": 5 } }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "approval" } }, "required": ["type"] },
            "then": { "required": ["gate"] }
          },
          {
            "if": { "not": { "properties": { "type": { "const": "approval" } }, "required": ["type"] } },
            "then": { "required": ["skill"] }
          }
        ]
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 5 },
        "onStates": { "type": "array", "items": { "type": "string" } },
        "routeTo": { "type": "string" }
      }
    },
    "policies": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "type", "producer"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["json", "markdown", "diff", "digest", "string"] },
          "producer": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
