{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ae.sh/schemas/routing.schema.json",
  "title": "AE canonical routing profiles",
  "description": "Provider-neutral task routing intents. Vendor model IDs belong in local ae.yaml, never in canonical assets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "useFor"],
        "properties": {
          "id": {
            "enum": ["fast", "balanced", "deep-reasoning", "independent-review", "recovery"]
          },
          "description": { "type": "string", "minLength": 40, "maxLength": 500 },
          "useFor": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "constraints": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
