{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aef.dev/schemas/issue.schema.json",
  "title": "Offline issue fixture",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "key", "summary", "acceptanceCriteria", "changedPaths"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$" },
    "summary": { "type": "string", "minLength": 4 },
    "description": { "type": "string" },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "changedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "semantics": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "array", "items": { "type": "string" } },
    "baseSHA": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "source": { "enum": ["fixture", "jira-cloud", "mcp"] }
  }
}
