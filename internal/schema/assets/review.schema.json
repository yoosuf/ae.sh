{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ae.sh/schemas/review.schema.json",
  "title": "AE structured review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "verified",
    "source",
    "diffDigest",
    "findings",
    "checksWithoutFindings",
    "note"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mode": { "enum": ["local-pattern-scan", "provider-backed-review"] },
    "verified": { "const": false },
    "pr": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "diffDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidateSHA": { "type": "string" },
    "baseSHA": { "type": "string" },
    "evidenceRecordID": { "type": "string" },
    "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "skill": { "enum": ["code-review", "security-review", "architecture-review", "test-review"] },
    "routingProfile": { "const": "independent-review" },
    "requestedModel": { "type": "string", "minLength": 1 },
    "model": { "type": "string" },
    "reviewMode": { "const": "provider-backed" },
    "independentReview": { "type": "boolean" },
    "simulated": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "severity",
          "status",
          "file",
          "line",
          "evidence",
          "impact",
          "remediation",
          "verified"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^rev-[0-9a-f]{16}$" },
          "ruleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "status": { "const": "hypothesis" },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 },
          "verified": { "const": false }
        }
      }
    },
    "checksWithoutFindings": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "ignoredInstructions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "note": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "provider-backed-review" } },
        "required": ["mode"]
      },
      "then": {
        "properties": { "findings": { "maxItems": 100 } }
      }
    }
  ]
}
